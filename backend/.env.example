# SchemeSmart Environment Configuration
# If Supabase credentials are provided, SchemeSmart connects directly to Supabase PostgreSQL + pgvector.
# If not provided, SchemeSmart smoothly uses its verified local database engine so that
# the system runs immediately and completely out-of-the-box for demos and evaluations.

SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

HOST=0.0.0.0
PORT=8005
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
